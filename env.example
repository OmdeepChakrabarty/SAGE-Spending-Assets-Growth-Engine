# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Cloudflare account id - found in the Cloudflare dashboard sidebar (Workers AI section).
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with Workers AI permissions.
# https://developers.cloudflare.com/fundamentals/api/get-started/create-token/
CLOUDFLARE_API_KEY=

# Cloudflare Workers AI model, in litellm's "cloudflare/<model>" format.
# Swap between these (or any other Workers AI text model) freely:
#   cloudflare/@cf/meta/llama-3.1-8b-instruct       (fast, good default)
#   cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8  (stronger, slower)
MODEL_NAME=cloudflare/@cf/meta/llama-3.1-8b-instruct

# Port the Gradio app listens on.
PORT=7860
